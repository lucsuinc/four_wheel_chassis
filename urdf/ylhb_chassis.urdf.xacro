<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ylhb_chassis">

  <!-- 按实际车量尺寸改 -->
  <xacro:property name="wheel_radius" value="0.15"/>
  <xacro:property name="base_length"  value="0.60"/>
  <xacro:property name="base_width"   value="0.50"/>
  <xacro:property name="base_height"  value="0.30"/>

  <!-- 里程计的 child frame：base_link 投影到地面 -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.9 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="footprint_to_base" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- IMU：位置按实际安装量改 -->
  <link name="imu_link"/>
  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.28 0 0.107" rpy="0 0 0"/>
  </joint>

  <!-- 雷达：yaw 按实际安装角度标定 -->
  <link name="laser_link"/>
  <joint name="base_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="-0.09 0 0.18" rpy="0 0 -1.5707963"/>
  </joint>

</robot>
